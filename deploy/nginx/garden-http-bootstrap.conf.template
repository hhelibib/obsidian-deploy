# Temporary HTTP-only config used before certificates exist.
# Path: /etc/nginx/conf.d/garden.conf

limit_req_zone $binary_remote_addr zone=garden_auth:10m rate=10r/m;

upstream artalk_backend {
    server 127.0.0.1:23366;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        auth_basic off;
    }

    auth_basic           "Garden — login required";
    auth_basic_user_file /etc/nginx/garden.htpasswd;
    limit_req zone=garden_auth burst=20 nodelay;

    root /var/www/garden;
    index index.html;

    location / {
        try_files $uri $uri/ $uri.html /404.html;
    }

    location /artalk/ {
        proxy_pass http://artalk_backend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        client_max_body_size 10m;
    }
}
