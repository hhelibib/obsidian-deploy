# Managed by garden-deploy. Domain is substituted at install time.
# Path: /etc/nginx/conf.d/garden.conf

limit_req_zone $binary_remote_addr zone=garden_auth:10m rate=10r/m;

upstream artalk_backend {
    server 127.0.0.1:23366;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # ACME / certbot
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Force login for the whole site (including comments API via same host)
    auth_basic           "Garden — login required";
    auth_basic_user_file /etc/nginx/garden.htpasswd;
    limit_req zone=garden_auth burst=20 nodelay;

    root /var/www/garden;
    index index.html;

    # Static Quartz site
    location / {
        try_files $uri $uri/ $uri.html /404.html;
    }

    # Artalk API + assets (only via Nginx, never exposed on public port)
    location /artalk/ {
        proxy_pass http://artalk_backend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        client_max_body_size 10m;
    }

    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }
}
