[Unit]
Description=Artalk comment server for Garden
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=artalk
Group=artalk
WorkingDirectory=/var/lib/artalk
ExecStart=/usr/local/bin/artalk server -w /var/lib/artalk -c /etc/artalk/artalk.yml
Restart=on-failure
RestartSec=3
# 避免过严沙箱在部分阿里云内核上导致 Go 二进制 SEGV
# （此前 ProtectSystem/PrivateTmp/NoNewPrivileges 组合曾触发段错误）
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
